# ==============================================================================
# SMART MARKETPLACE - DOCKER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN: Copy file này thành '.env' và điền thông tin thật của bạn.
# Trên VPS: Đổi 'localhost' thành IP thật của VPS hoặc Tên miền của bạn.
# ==============================================================================

# 1. Cấu hình cơ sở dữ liệu MySQL
DB_HOST=mysql
DB_PORT=3307
DB_NAME=smart_marketplace
DB_USER=root
DB_PASSWORD=your_strong_mysql_password_here

# 2. Cấu hình MongoDB (Chat thời gian thực)
MONGO_PORT=27018
MONGODB_CONNECTION_STRING=mongodb://mongodb:27017
MONGODB_DATABASE=message-management

# 3. Cấu hình bảo mật JWT Token (Tối thiểu 32 ký tự ngẫu nhiên)
Jwt__Key=your_random_secret_jwt_key_here_min_32_characters
Jwt__Issuer=smart-marketplace
Jwt__Audience=smart-marketplace
Jwt__ExpiresMinutes=1440
JWT_SECRET=your_random_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=24h

# 4. Cấu hình môi trường ASP.NET Core & CORS
ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# 5. Cấu hình Frontend API Endpoint (Nhúng vào lúc build React)
VITE_API_URL=/api
VITE_CHAT_HUB_URL=/hubs/chat

# 6. Cấu hình SSL & Nginx Production (Trên VPS Production)
# SSL_CERTS_PATH=/etc/letsencrypt
# NGINX_CONF_PATH=./frontend/nginx.prod.conf
# CERTBOT_WWW_PATH=/var/www/certbot

# 6. Cloudinary Storage (Lưu trữ ảnh đại diện, ảnh công việc)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. Email SMTP Gmail (Gửi mã OTP khôi phục mật khẩu)
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__SenderEmail=your_email@gmail.com
EmailSettings__SenderName=TaskMate Support
EmailSettings__Password=your_gmail_app_password_16_characters
