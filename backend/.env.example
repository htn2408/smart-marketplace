# ==============================================================================
# SMART MARKETPLACE - ENVIRONMENT EXAMPLE TEMPLATE (.env.example)
# ==============================================================================
# Hãy sao chép file này thành .env và điền các giá trị thực tế của môi trường.
# ==============================================================================

# 1. Cấu hình cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_marketplace
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Chuỗi kết nối hoàn chỉnh (hoặc để trống nếu đã cấu hình các biến DB_* ở trên)
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=smart_marketplace;User=root;Password=your_mysql_password_here;

# 2. Cấu hình bảo mật JWT Token (Tối thiểu 32 ký tự)
Jwt__Key=your-very-strong-secret-key-at-least-32-characters-long
Jwt__Issuer=smart-marketplace
Jwt__Audience=smart-marketplace
Jwt__ExpiresMinutes=1440

# Biến alias phụ trợ
JWT_SECRET=your-very-strong-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=24h

# 3. Cấu hình Server & Môi trường ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5236

# 4. CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 5. Cloudinary Storage (Tùy chọn)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 6. MongoDB Configuration (Chat & Realtime)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE=message-management
